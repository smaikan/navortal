{
  "name": "adhd-planner-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node tools/server.mjs --dev --port 3100",
    "build": "next build",
    "start": "node tools/server.mjs --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "lint": "prettier --check src tests && eslint src tests next.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "python tools/run-e2e.py",
    "test:browsers": "node tools/install-browsers.mjs",
    "api:generate": "npm --prefix tools/api-types run generate",
    "api:check": "npm --prefix tools/api-types run check",
    "check:browser-syntax": "node tools/check-browser-syntax.mjs",
    "postbuild": "npm run check:browser-syntax"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.104.3",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "browserslist": [
    "chrome >= 90",
    "safari >= 14",
    "ios_saf >= 14",
    "firefox >= 88",
    "edge >= 90"
  ]
}
