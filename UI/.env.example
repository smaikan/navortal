# Yalnız HTTP geliştirme proxy'si. Production SignalR yükseltmesi ayrı kabul ister.
API_ORIGIN=http://127.0.0.1:5080
NEXT_TELEMETRY_DISABLED=1
# İzole yerel test sunucusu dışında false kalsın.
UI_E2E_CHECKS=false
# Canlı alan adı ve indeksleme .env.production içindedir. Önizleme ortamında SITE_INDEXING=false verin. Burada localhost kullanmayın.
# SITE_URL=https://your-public-domain
# Yalnız production'da açıkça açılır. Önizlemede false; VERCEL_ENV=preview de indekslemeyi durdurur.
SITE_INDEXING=false
# Açık yasal kimlik bilgisi, yasal sayfalarda gösterilir. Buraya sır yazmayın.
# Varsayılanlar src/features/legal/profile.ts içindedir; burada verilen değer onları değiştirir, boş değer taslağa döndürür.
# LEGAL_CONTROLLER_NAME=
# LEGAL_CONTROLLER_ADDRESS=
# LEGAL_CONTACT_EMAIL=info@navortal.com.tr  (boşsa bu adres kullanılır)
# LEGAL_HOSTING_DESCRIPTION=Sağlayıcı, işleme/saklama ülkeleri ve alıcı amacı
# LEGAL_EMAIL_DESCRIPTION=Sağlayıcı, işleme ülkeleri ve alıcı amacı veya kapalı bilgisi
# LEGAL_RETENTION_DESCRIPTION=Veri türüne göre doğrulanmış saklama, silme ve yedek takvimi
