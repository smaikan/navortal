# copy to .env.local and change what you need

# backend address (dev)
API_ORIGIN=http://127.0.0.1:5080
NEXT_TELEMETRY_DISABLED=1

# only true when running e2e tests
UI_E2E_CHECKS=false

# public site url, needed for sitemap and og tags
# SITE_URL=https://example.com
# keep false outside production
SITE_INDEXING=false

# legal page info (optional, defaults are in src/features/legal/profile.ts)
# LEGAL_CONTROLLER_NAME=
# LEGAL_CONTROLLER_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_HOSTING_DESCRIPTION=
# LEGAL_EMAIL_DESCRIPTION=
# LEGAL_RETENTION_DESCRIPTION=
