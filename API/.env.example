# Profil fotoğrafı ayarını API okur. Yerelde ve Docker Compose ile .local/cloudinary.env kullanılır.
Cloudinary__Enabled=false
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Google kimlik doğrulama ayarları. Yerelde ve üretimde .local/api.env kullanılır.
Google__Enabled=false
Google__ClientId=

# Native Android FCM (Web Push'tan bağımsız, varsayılan kapalı sunucu transport'u).
Firebase__Enabled=false
Firebase__ProjectId=navortal
Firebase__ServiceAccountPath=/opt/navortal/API/.local/firebase-service-account.json
Firebase__AndroidPackageName=tr.com.navortal
Firebase__TimerSyncEnabled=false
