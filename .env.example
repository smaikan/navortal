# Docker Compose gizli degerleri kokteki .env dosyasinda degil, ignore edilen API/.local altinda durur.
#
# API/.local/postgres.env
# POSTGRES_PASSWORD=change-me
#
# API/.local/api.env (sifre postgres.env ile ayni olmali; JWT en az 32 bayt: openssl rand -base64 48)
# Jwt__SigningKey=
# ConnectionStrings__Planner=Host=db;Database=adhd;Username=adhd;Password=change-me
#
# Istege bagli: API/.local/smtp.env, API/.local/cloudinary.env, UI/.env.production
